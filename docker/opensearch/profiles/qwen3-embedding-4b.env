# Production profile. Quantized Qwen3-Embedding-4B via llama.cpp.
# Default quant is Q4_K_M (2.33 GiB). Switch to Q8_0 by changing the three
# GGUF_* lines to Qwen3-Embedding-4B-Q8_0.gguf and size 4279660224.
# Full vector is 2560. To truncate with MRL, set EMBEDDING_DIMENSION (for
# example 1024) and EMBEDDING_MRL=true. Do not reuse an index built at another width.
EMBEDDING_PROFILE=qwen3-embedding-4b
EMBEDDING_BACKEND=llama-cpp-proxy
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-4B
EMBEDDING_GGUF_REPO=Qwen/Qwen3-Embedding-4B-GGUF
EMBEDDING_GGUF_FILE=Qwen3-Embedding-4B-Q4_K_M.gguf
EMBEDDING_GGUF_SIZE=2496703776
EMBEDDING_QUANT=Q4_K_M
EMBEDDING_DIMENSION=2560
EMBEDDING_NATIVE_DIMENSION=2560
EMBEDDING_MRL=false
EMBEDDING_APPEND_EOS=<|endoftext|>
LLAMA_PORT=8081
LLAMA_CTX=8192
LLAMA_THREADS=4
EMBEDDING_HOST=0.0.0.0
EMBEDDING_PORT=18080
EMBEDDING_UPSTREAM_URL=http://127.0.0.1:8081/v1/embeddings
EMBEDDING_URL=http://127.0.0.1:18080/v1/embeddings
EMBEDDING_API_KEY=local-embedding
EMBEDDING_CONNECTOR_NAME=ragflow_qwen3_embedding_4b
EMBEDDING_PIPELINE=ragflow_qwen3_embedding_4b
EMBEDDING_INDEX=ragflow_qwen3_embedding_4b_sample
EMBEDDING_MODEL_GROUP=ragflow_multilingual_embedding
