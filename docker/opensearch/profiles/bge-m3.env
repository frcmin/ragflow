# Test profile. Same OpenSearch connector path as production, different model.
# Compose overrides EMBEDDING_URL to the Docker DNS name; these values are for
# running the scripts directly on a host.
EMBEDDING_PROFILE=bge-m3
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_NATIVE_DIMENSION=1024
EMBEDDING_MRL=false
EMBEDDING_APPEND_EOS=
EMBEDDING_HOST=0.0.0.0
EMBEDDING_PORT=18080
EMBEDDING_URL=http://127.0.0.1:18080/v1/embeddings
EMBEDDING_API_KEY=local-embedding
EMBEDDING_CONNECTOR_NAME=ragflow_bge_m3
EMBEDDING_PIPELINE=ragflow_bge_m3_embedding
EMBEDDING_INDEX=ragflow_bge_m3_sample
EMBEDDING_MODEL_GROUP=ragflow_multilingual_embedding
